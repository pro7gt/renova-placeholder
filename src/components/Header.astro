---
// Header Component with responsive navigation & accessible mobile menu
---
<header>
  <div class="wrap nav">
    <a href="#top" class="logo" aria-label="Renova TMS home"></a>
    <nav class="nav-links" id="navlinks" aria-label="Main navigation">
      <a class="link" href="#about">About</a>
      <a class="link" href="#principles">Principles</a>
      <a class="link" href="#join">Join us</a>
      <a class="link" href="#referrers">Referrers</a>
      <a href="#register" class="btn btn-primary">Register your interest</a>
    </nav>
    <button class="menu-btn" id="menuBtn" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="navlinks">
      <span class="menu-icon" aria-hidden="true">
        <span class="menu-bar bar-1"></span>
        <span class="menu-bar bar-2"></span>
        <span class="menu-bar bar-3"></span>
      </span>
    </button>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menuBtn') as HTMLButtonElement | null;
  const navLinks = document.getElementById('navlinks') as HTMLElement | null;

  function closeMenu() {
    if (navLinks && menuBtn) {
      navLinks.classList.remove('open');
      menuBtn.setAttribute('aria-expanded', 'false');
    }
  }

  if (menuBtn && navLinks) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      navLinks.classList.toggle('open', nextState);
      menuBtn.setAttribute('aria-expanded', String(nextState));
    });

    navLinks.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close on Escape key press
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navLinks.classList.contains('open')) {
        closeMenu();
        menuBtn.focus();
      }
    });

    // Close on click outside header
    document.addEventListener('click', (e) => {
      const target = e.target as Node | null;
      if (navLinks.classList.contains('open') && target && !navLinks.contains(target) && !menuBtn.contains(target)) {
        closeMenu();
      }
    });
  }
</script>
