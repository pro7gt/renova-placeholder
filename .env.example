# Environment Configuration for Renova TMS Placeholder
# In Cloudflare Pages, configure these under Settings > Environment variables

# Target notification email (defaults to admin@renovatms.com if unset)
TO_EMAIL=admin@renovatms.com

# Resend API Key for email delivery (optional, fallback to preview logging if unset)
# https://resend.com
RESEND_API_KEY=

# Cloudflare Turnstile Bot Protection (optional, token verified if keys are present)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
